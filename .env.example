# tokenomix server environment variables
#
# Copy this file to .env and adjust values for your setup.
# The server validates all variables at startup and exits non-zero on error.
#
# .env files are gitignored. .env.example is committed as the env contract.

# ---------------------------------------------------------------------------
# Port
# ---------------------------------------------------------------------------

# Base port for the development setup.
# The server listens on PORT_BASE + 1 (default 3001).
# The Vite dev server listens on PORT_BASE (default 3000).
# Must be an integer between 1 and 65534.
PORT_BASE=3000

# ---------------------------------------------------------------------------
# Pricing configuration
# ---------------------------------------------------------------------------

# Pricing provider to use for cost computation.
# Valid values: anthropic_1p | aws_bedrock | internal_gateway
# Default: anthropic_1p
TOKENOMIX_PRICING_PROVIDER=anthropic_1p

# AWS region used for Bedrock pricing calculations.
# Only relevant when TOKENOMIX_PRICING_PROVIDER=aws_bedrock or internal_gateway.
# Example: us-east-1
# Default: unset (null)
# TOKENOMIX_BEDROCK_REGION=us-east-1

# Bedrock cross-region endpoint scope used for latency-based pricing multipliers.
# Valid values: in_region | global_cross_region | geographic_cross_region | unknown
# Default: unknown
# TOKENOMIX_BEDROCK_ENDPOINT_SCOPE=in_region

# Bedrock service tier that affects the pricing multiplier.
# Valid values: standard | batch | provisioned | reserved | unknown
# Default: standard
# TOKENOMIX_BEDROCK_SERVICE_TIER=standard

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Enable debug-level log output to stdout.
# Set to "1" to enable; any other value (or unset) disables debug logs.
# Default: unset (debug disabled)
# TOKENOMIX_DEBUG=1

# ---------------------------------------------------------------------------
# File watcher
# ---------------------------------------------------------------------------

# Use FSEvents (macOS native) instead of polling for JSONL file change detection.
# Set to "1" to enable FSEvents; any other value (or unset) uses polling.
# Polling is the default because it is more compatible across environments.
# Default: unset (polling enabled)
# TOKENOMIX_WATCHER_FSEVENTS=1

# ---------------------------------------------------------------------------
# Claude subprocess (chatbot / recommendations)
# ---------------------------------------------------------------------------

# Absolute path or plain basename of the Claude CLI executable.
# When unset, the server auto-detects in this order:
#   1. ~/.local/bin/claude (if executable)
#   2. "claude" (relies on PATH)
# Example values: /usr/local/bin/claude  |  claude
# Default: auto-detected
# TOKENOMIX_CLAUDE_COMMAND=/usr/local/bin/claude

# Maximum time in milliseconds to wait for a Claude subprocess response.
# Must be a positive integer.
# Default: 60000 (60 seconds)
# TOKENOMIX_CLAUDE_CHAT_TIMEOUT_MS=60000

# Maximum spend budget per Claude chat request in USD.
# Passed as --max-turns budget to the subprocess. Accepts decimal strings.
# Default: 0.15
# TOKENOMIX_CLAUDE_CHAT_MAX_BUDGET_USD=0.15

# Claude model alias or full model ID to use for chatbot requests.
# Examples: sonnet | opus | claude-sonnet-4-6-20260101
# Default: sonnet
# TOKENOMIX_CLAUDE_CHAT_MODEL=sonnet

# Effort level hint passed as --effort to the Claude subprocess.
# Valid values: low | medium | high | xhigh | max
# When unset, the model's default effort level is used.
# Default: unset (model default)
# TOKENOMIX_CLAUDE_CHAT_EFFORT=medium

# Run Claude without the built-in system prompt (bare / raw mode).
# Set to "1", "true", or "yes" to enable; any other value (or unset) disables.
# Default: unset (system prompt enabled)
# TOKENOMIX_CLAUDE_CHAT_BARE=0

# ---------------------------------------------------------------------------
# In-memory store size limits (advanced tuning)
# ---------------------------------------------------------------------------

# Maximum number of JSONL file-path entries retained in the file-ingestion
# audit map. Older entries are evicted at 10% batches when the cap is reached.
# Must be a positive integer.
# Default: 10000
# TOKENOMIX_MAX_FILE_AUDITS=10000

# Maximum number of agent-ID entries retained in the requestedModelByAgentId
# and subagentFilePathsByAgentId maps. Older entries are evicted at 10% batches.
# Must be a positive integer.
# Default: 20000
# TOKENOMIX_MAX_AGENT_ENTRIES=20000
